# ==============================================================================
# NekoNihongo Environment Variables
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (Optional - falls back to robust Local/Offline persistence if not configured)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional AI Tutor Integration (e.g. Gemini API or OpenAI compatible)
GEMINI_API_KEY=your-gemini-api-key-here
AI_TUTOR_MODEL=gemini-1.5-flash

# Environment
NODE_ENV=development
